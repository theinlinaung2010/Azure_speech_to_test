   "source": [
    "import re\n",
    "\n",
    "with open('result-2_nospace.txt', 'r', encoding=\"utf8\") as f:\n",
    "    text = f.read()\n",
    "\n",
    "text = re.sub(r'\\d+:\\d+:\\d+ --> \\d+:\\d+:\\d+\\n', '', text)\n",
    "text = text.replace('(new paragraph)', '\\n\\n')\n",
    "\n",
    "with open('paragraph.txt', 'w', encoding=\"utf8\") as f:\n",
    "    f.write(text)"
   ]
